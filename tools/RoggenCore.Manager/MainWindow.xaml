<Window x:Class="RoggenCore.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RoggenCore Manager" Height="780" Width="1180" MinHeight="680" MinWidth="980"
        Background="#101416" Foreground="#F4F1E8" FontFamily="Segoe UI" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#1A2023" />
        <SolidColorBrush x:Key="Accent" Color="#E9A23B" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#E9A23B"/><Setter Property="Foreground" Value="#17130D"/>
            <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252D31"/><Setter Property="Foreground" Value="#F4F1E8"/>
            <Setter Property="BorderBrush" Value="#455158"/><Setter Property="Padding" Value="9"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource Card}"/><Setter Property="BorderBrush" Value="#303A3F"/>
            <Setter Property="Padding" Value="14"/><Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="ROGGENCORE" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="14"/>
                <TextBlock Text="Device Manager" FontWeight="SemiBold" FontSize="34"/>
                <TextBlock Text="Safe recovery, verified firmware, and traceable backups" Foreground="#AEB8BC" FontSize="14"/></StackPanel>
            <Border Grid.Column="1" Background="#162C24" CornerRadius="14" Padding="15,9" VerticalAlignment="Center">
                <TextBlock x:Name="ConnectionBadge" Text="No bridge connected" Foreground="#7DE0AE" FontWeight="SemiBold"/></Border>
        </Grid>

        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabItem Header="DEVICE">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0">
                    <GroupBox Header="ESP32 bridge">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="AddressBox" Text="http://swd.local" VerticalAlignment="Top"/>
                            <Button Grid.Column="2" Content="Discover" Click="Discover_Click" Margin="10,0,8,0"/>
                            <Button Grid.Column="3" Content="Connect &amp; inspect" Click="Connect_Click" Margin="0"/>
                            <TextBox x:Name="WifiSsidBox" Grid.Row="1" Margin="0,10,8,0" ToolTip="Wi-Fi network name"/>
                            <PasswordBox x:Name="WifiPasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,10,8,0" Padding="9" Background="#252D31" Foreground="#F4F1E8" BorderBrush="#455158" ToolTip="Wi-Fi password"/>
                            <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Content="Save Wi-Fi over USB" Click="ConfigureWifi_Click" Margin="0,10,0,0"/>
                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Detected hardware">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Target" Foreground="#93A0A5"/><TextBlock x:Name="TargetText" Text="Not inspected" FontSize="22" Margin="0,3,0,14"/>
                                <TextBlock Text="Display" Foreground="#93A0A5"/><TextBlock x:Name="DisplayText" Text="—" FontSize="18"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Identity" Foreground="#93A0A5"/><TextBlock x:Name="IdentityText" Text="—" FontFamily="Consolas" FontSize="16" Margin="0,3,0,14"/>
                                <TextBlock Text="USB serial ports" Foreground="#93A0A5"/><TextBlock x:Name="PortsText" Text="None detected" FontFamily="Consolas"/></StackPanel>
                        </Grid>
                    </GroupBox>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Run post-unlock tests" Click="Diagnostics_Click"/>
                        <Button Content="Create verified backup" Click="Backup_Click"/>
                        <Button Content="Open backup folder" Click="OpenBackups_Click"/>
                        <Button Content="Import backups…" Click="ImportBackups_Click"/>
                    </StackPanel>
                    <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True" Height="180" FontFamily="Consolas" VerticalScrollBarVisibility="Auto"/>
                </StackPanel></ScrollViewer>
            </TabItem>

            <TabItem Header="FIRMWARE">
                <StackPanel Margin="0,18,0,0">
                    <GroupBox Header="Verified package">
                        <StackPanel><TextBlock x:Name="PackageText" Text="No package selected" FontSize="18" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal"><Button Content="Choose manifest…" Click="ChoosePackage_Click"/><Button x:Name="InstallButton" Content="Backup, install &amp; verify" Click="Install_Click" IsEnabled="False"/></StackPanel>
                            <TextBlock Text="Normal upgrades erase only manifest-approved pages. The CPU remains halted if readback differs by even one byte." TextWrapping="Wrap" Foreground="#AEB8BC"/></StackPanel>
                    </GroupBox>
                    <GroupBox Header="Factory recovery / unlock">
                        <StackPanel><TextBlock Text="This permanently clears the factory firmware and protection state. It requires a recovery-capable package with MBR, SoftDevice, application, and board UICR defaults." TextWrapping="Wrap" Foreground="#F5BD72" Margin="0,0,0,10"/>
                            <TextBlock x:Name="ConfirmationHint" Text="Inspect a target to generate its confirmation phrase." Margin="0,0,0,5"/>
                            <TextBox x:Name="ConfirmationBox" Margin="0,0,0,10"/>
                            <Button Content="Unlock, install &amp; verify" HorizontalAlignment="Left" Background="#C85B55" Foreground="White" Click="Recover_Click"/></StackPanel>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="BACKUPS">
                <Grid Margin="0,18,0,0"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="BackupsGrid" IsReadOnly="True" AutoGenerateColumns="False" Background="#1A2023" Foreground="#101416" RowBackground="#F4F1E8" AlternatingRowBackground="#DFE4E2">
                    <DataGrid.Columns><DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedUtc}" Width="190"/><DataGridTextColumn Header="Device" Binding="{Binding DeviceId, StringFormat=X16}" Width="150"/><DataGridTextColumn Header="Firmware" Binding="{Binding FirmwareName}" Width="*"/><DataGridTextColumn Header="Version" Binding="{Binding FirmwareVersion}" Width="100"/><DataGridCheckBoxColumn Header="Known good" Binding="{Binding KnownGood}" Width="90"/><DataGridTextColumn Header="CRC-32" Binding="{Binding FlashCrc32, StringFormat=X8}" Width="100"/></DataGrid.Columns>
                </DataGrid><Button Grid.Row="1" Content="Restore selected backup…" HorizontalAlignment="Left" Margin="0,12,0,0" Background="#C85B55" Foreground="White" Click="RestoreBackup_Click"/></Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" Foreground="#AEB8BC"/>
            <ProgressBar x:Name="Progress" Grid.Column="1" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource Accent}"/>
        </Grid>
    </Grid>
</Window>
